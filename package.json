{
  "name": "minimail",
  "productName": "Minimail",
  "version": "0.6.1",
  "description": "One window for all your web mail - Gmail, Outlook, Yahoo, Proton and more",
  "private": true,
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "autotest": "electron . --autotest",
    "experiment": "electron . --experiment",
    "icons": "node scripts/make-icon.js",
    "banner": "electron scripts/make-banner.js",
    "dist": "electron-builder --win",
    "icon-concepts": "node scripts/icon-concepts.js"
  },
  "build": {
    "appId": "io.github.minimail",
    "productName": "Minimail",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/bench.js",
      "!src/diagnostics.js",
      "package.json",
      "LICENSE"
    ],
    "protocols": {
      "name": "Email",
      "schemes": [
        "mailto"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minimail"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.1"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.1"
  }
}
